# STR Optimizer API — local development settings. Copy to .env and fill in.
# NEVER put real keys in this file: it is committed to a public repository.

DATABASE_URL=postgresql://localhost/str_optimizer
PGSSLMODE=disable

STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_ANNUAL=price_REPLACE_ME

SENDGRID_API_KEY=REPLACE_ME
UNSUBSCRIBE_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
BRIEF_FROM_EMAIL=briefs@optimizemystr.com
SUPPORT_EMAIL=support@optimizemystr.com
FRONTEND_URL=http://localhost:8080
API_BASE_URL=http://localhost:5001

# Optional
AIRROI_API_KEY=
OPENAI_API_KEY=
BRIEF_LLM_MODEL=
