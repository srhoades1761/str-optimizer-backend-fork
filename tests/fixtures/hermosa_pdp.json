{"niobeClientData":[["StaysPdpSections",{"data":{"presentation":{"stayProductDetailPage":{"sections":{"metadata":{"sharingConfig":{"title":"Home in Pagosa Springs · ★4.87 · 2 bedrooms · 4 beds · 1.5 baths","personCapacity":6,"reviewCount":134,"starRating":4.87},"loggingContext":{"eventDataLogging":{"listingId":"50439899","listingLat":37.26649,"listingLng":-107.00503,"roomType":"Entire home/apt","personCapacity":6,"isSuperhost":false,"accuracyRating":4.89,"checkinRating":4.98,"cleanlinessRating":4.73,"communicationRating":4.96,"locationRating":4.97,"valueRating":4.73,"guestSatisfactionOverall":4.87,"visibleReviewCount":"134"}}},"sections":[{"sectionId":"DESCRIPTION_MODAL","section":{"title":"About this space","items":[{"title":null,"html":{"htmlText":"Welcome to the newly remodeled Hermosa Cottage, your cozy home base in the heart of downtown Pagosa Springs! Just steps from hot springs, breweries, coffee shops, the Riverwalk, and parks, you can explore it all on foot.<br /><br />This stylish and historic cottage is designed for relaxation, comfort, and fun — perfect for families, couples, or a solo retreat. Enjoy mornings on the front porch, meals at the backyard picnic table, and evenings soaking in your private hot tub under the stars."}},{"title":"The space","html":{"htmlText":"The Hermosa Cottage is freshly updated and convenient to everything in downtown Pagosa! From the front yard, you can hear the river flowing across street.<br /><br />We have one bedroom with a queen bed on the bottom floor. The upstairs is an “open” space with two sleeping areas separated by a small bathroom and the stairway. You can see from one space to the other but there is still privacy for changing. <br />We do have an AC unit in the upstairs. The lower level stays pleasant by opening windows at night and closing in the morning to keep the cool air in.<br /><br />We have a well stocked kitchen for you to use, a work space for those zoom meetings, and a washer and dryer. Located out back is a 4 person hot tub for your enjoyment."}},{"title":"Other things to note","html":{"htmlText":"This is a historic home from the early 1900s. The stairway to the second floor could be challenging to those with mobility concerns. This is NOT a pet friendly home due to allergies, sorry for the inconvenience."}}]}}]}}},"node":{"pdpPresentation":{"title":{"content":{"localizedString":"Cozy Downtown Cottage | Hot Tub + Family-Friendly!"}},"location":{"latitude":37.26649,"longitude":-107.00503,"subtitle":"Pagosa Springs, Colorado, United States","locationName":null},"quality":{"isGuestFavorite":true,"categoryRatings":[{"categoryType":"CLEANLINESS","localizedRating":"4.7","label":"Cleanliness"},{"categoryType":"ACCURACY","localizedRating":"4.9","label":"Accuracy"},{"categoryType":"CHECKIN","localizedRating":"5.0","label":"Check-in"},{"categoryType":"COMMUNICATION","localizedRating":"5.0","label":"Communication"},{"categoryType":"LOCATION","localizedRating":"5.0","label":"Location"},{"categoryType":"VALUE","localizedRating":"4.7","label":"Value"}],"reviewTags":[{"name":"HOT_TUB","count":31,"localizedName":"Hot tub"},{"name":"LOCATION","count":86,"localizedName":"Location"},{"name":"WALKABILITY","count":67,"localizedName":"Walkability"},{"name":"SKIING","count":11,"localizedName":"Skiing"},{"name":"FAMILY","count":30,"localizedName":"Family"},{"name":"RIVER","count":14,"localizedName":"River"},{"name":"COMFORT","count":32,"localizedName":"Comfort"},{"name":"NEARBY","count":32,"localizedName":"Nearby"},{"name":"CLEANLINESS","count":23,"localizedName":"Cleanliness"},{"name":"HOSPITALITY","count":30,"localizedName":"Hospitality"}]},"amenities":{"seeAllAmenitiesGroups":[{"title":"Bathroom","amenities":[{"title":"Bathtub","available":true},{"title":"Hair dryer","available":true},{"title":"Cleaning products","available":true},{"title":"Shampoo","available":true},{"title":"Conditioner","available":true},{"title":"Hot water","available":true}]},{"title":"Bedroom and laundry","am